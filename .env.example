# The Saviour - Environment Configuration (Client-side)
# Copy this file to `.env` and fill in your Supabase project credentials.
# NOTE: Only public anon keys belong here. NEVER paste your Supabase `service_role` key!

# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon / Publishable Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
